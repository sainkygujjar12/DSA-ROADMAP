NODE_ENV=development
PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/dsa-roadmap
MONGO_MAX_POOL_SIZE=20
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_URL=http://localhost:5174
GOOGLE_CLIENT_ID=
EMAIL_HOST=smtp.gmail.com
# Render Free: use smtp2go (HTTPS) and configure a verified sender in SMTP2GO.
EMAIL_PROVIDER=smtp
SMTP2GO_API_KEY=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
# Set only to the exact trusted reverse-proxy hop count for your host.
TRUST_PROXY_HOPS=0
