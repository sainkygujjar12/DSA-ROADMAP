PORT=8000

# MongoDB Atlas connection string (get from your Atlas cluster)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dsa-roadmap?retryWrites=true&w=majority

# Use a long, random string in production — e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-secret

# Get this from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Comma-separated list of allowed frontend origins in production
# e.g. https://dsaroadmap.vercel.app
CLIENT_URL=

# Used to send OTP verification emails on signup.
# For Gmail: enable 2FA on the account, then generate an
# App Password at https://myaccount.google.com/apppasswords
# (NOT your regular Gmail password — it won't work here).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password
EMAIL_FROM=your-email@gmail.com

