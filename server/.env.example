NODE_ENV=development
PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/dsa-roadmap
MONGO_MAX_POOL_SIZE=20
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_URL=http://localhost:5174
GOOGLE_CLIENT_ID=
EMAIL_HOST=smtp.gmail.com
# Render Free: use gmail (HTTPS). See docs/GMAIL_SETUP.md for sender authorization.
EMAIL_PROVIDER=smtp
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional alternative if you already have a SMTP2GO account.
SMTP2GO_API_KEY=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
# Set only to the exact trusted reverse-proxy hop count for your host.
TRUST_PROXY_HOPS=0
